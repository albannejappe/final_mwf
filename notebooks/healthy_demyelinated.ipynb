import numpy as np
import plotly.graph_objects as go
import ipywidgets as widgets
from IPython.display import display

TE = np.linspace(0, 300, 200)

# Fixed relaxation times
T2_MW = 20
T2_IEW = 80

def compare_tissues(
    MWF_healthy=20,
    MWF_demyelinated=10
):

    # Healthy tissue
    healthy_MW = (
        MWF_healthy / 100
        * np.exp(-TE / T2_MW)
    )

    healthy_IEW = (
        (1 - MWF_healthy / 100)
        * np.exp(-TE / T2_IEW)
    )

    healthy_total = healthy_MW + healthy_IEW

    # Demyelinated tissue
    demyelinated_MW = (
        MWF_demyelinated / 100
        * np.exp(-TE / T2_MW)
    )

    demyelinated_IEW = (
        (1 - MWF_demyelinated / 100)
        * np.exp(-TE / T2_IEW)
    )

    demyelinated_total = (
        demyelinated_MW + demyelinated_IEW
    )

    # Create figure
    fig = go.Figure()

    fig.add_trace(
        go.Scatter(
            x=TE,
            y=healthy_total,
            name="Healthy tissue",
            line=dict(width=3)
        )
    )

    fig.add_trace(
        go.Scatter(
            x=TE,
            y=demyelinated_total,
            name="Demyelinated tissue",
            line=dict(width=3)
        )
    )

    fig.update_layout(
        title="Comparison of T2 Signal Decay",
        xaxis_title="Echo Time (ms)",
        yaxis_title="Normalized signal",
        template="plotly_white",
        height=450,
        hovermode="x unified"
    )

    display(fig)

    print(f"Healthy tissue MWF: {MWF_healthy}%")
    print(f"Demyelinated tissue MWF: {MWF_demyelinated}%")

    print(
        f"MWF difference: "
        f"{MWF_healthy - MWF_demyelinated:.1f} percentage points"
    )


controls = widgets.interactive(
    compare_tissues,

    MWF_healthy=widgets.IntSlider(
        value=20,
        min=5,
        max=40,
        step=1,
        description="Healthy (%)"
    ),

    MWF_demyelinated=widgets.IntSlider(
        value=10,
        min=1,
        max=30,
        step=1,
        description="Demyelinated (%)"
    )
)

display(controls)
